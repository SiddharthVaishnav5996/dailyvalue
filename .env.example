# -----------------------------------------------------------------------------
# DailyValue environment variables
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored so your secrets never get committed.
# -----------------------------------------------------------------------------

# Google Gemini API key — powers recipe generation + ingredient extraction.
# Get a FREE key at https://aistudio.google.com/app/apikey
# The app also runs WITHOUT a key (it falls back to a built-in demo recipe
# engine), so you can try it before setting this up.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to a fast, free-tier model).
# GEMINI_MODEL=gemini-2.0-flash
